{
  "name": "knowledge-quest-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:host": "npm run start --workspace=knowledge-quest",
    "start:lemon-brains": "npm run start --workspace=lemon-brains -- --port 4200",
    "start:fairy-tale-kingdom": "npm run start --workspace=fairy-tale-kingdom",
    "build:host": "npm run build --workspace=knowledge-quest",
    "build:lemon-brains": "npm run build --workspace=lemon-brains",
    "build:fairy-tale-kingdom": "npm run build --workspace=fairy-tale-kingdom",
    "build:pages": "node scripts/build-pages.mjs",
    "test:lemon-brains": "npm run test --workspace=lemon-brains -- --no-watch --browsers=ChromeHeadless",
    "test:fairy-tale-kingdom": "npm run test --workspace=fairy-tale-kingdom"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.11",
    "@angular/cli": "^17.3.11",
    "@angular/compiler-cli": "^17.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.2"
  }
}
